{
  "name": "pairlit-social",
  "main": "cloud-worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pairlit-social-agents",
      "database_id": "90ba08d9-0265-44eb-abf2-d2e773875819"
    }
  ],
  "vars": {
    "PAIRLIT_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "PAIRLIT_TOTAL_CAP_USD": ".50"
  },
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}